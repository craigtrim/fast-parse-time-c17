#include <winver.h>

1 VERSIONINFO
 FILEVERSION @FPT_WINDOWS_VERSION@
 PRODUCTVERSION @FPT_WINDOWS_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Fast Parse Time C17 command-line parser\0"
            VALUE "FileVersion", "@FPT_FULL_VERSION@\0"
            VALUE "InternalName", "fpt\0"
            VALUE "OriginalFilename", "fpt.exe\0"
            VALUE "ProductName", "fast-parse-time-c17\0"
            VALUE "ProductVersion", "@FPT_FULL_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
